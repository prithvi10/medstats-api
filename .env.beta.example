# Local beta — copy to .env.beta and fill in secrets
ENV=production
DEBUG=false
SEED_DEMO_USERS=true
BETA_HTTP_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres
POSTGRES_USER=medstats
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medstats
DATABASE_URL=postgresql+asyncpg://medstats:CHANGE_ME@db:5432/medstats
DATABASE_URL_SYNC=postgresql://medstats:CHANGE_ME@db:5432/medstats

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Auth
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# OpenAI
OPENAI_API_KEY=sk-...

# Email — SMTP (beta). Use Gmail app password, Resend SMTP, or Mailgun.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_USE_TLS=true
EMAIL_FROM="MedStats Beta <you@gmail.com>"
EMAIL_REPLY_TO=you@gmail.com

# Alerting — comma-separated admin emails for stack failures
ALERT_EMAIL_TO=you@gmail.com

# Optional: webhook for Slack/Discord (POST JSON {"text": "..."})
ALERT_WEBHOOK_URL=

# App URL shown in emails
APP_BASE_URL=http://localhost:3000

# NCBI
NCBI_EMAIL=you@gmail.com

# Uploads (local volume in beta)
UPLOAD_DIR=/app/uploads

# S3 optional — leave blank to use local disk
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Sentry optional
SENTRY_DSN=
