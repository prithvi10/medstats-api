# App
ENV=production
DEBUG=false
CORS_ORIGINS=https://yourdomain.com

# Postgres (used by db service AND app)
POSTGRES_USER=medstats
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medstats
DATABASE_URL=postgresql+asyncpg://medstats:CHANGE_ME@db:5432/medstats
DATABASE_URL_SYNC=postgresql://medstats:CHANGE_ME@db:5432/medstats

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_REASONING=o1-mini

# NCBI / PubMed
NCBI_EMAIL=admin@yourdomain.com

# AWS S3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=medstats-uploads
S3_REGION=ap-northeast-1

# Uploads
UPLOAD_DIR=/app/uploads

# Sentry
SENTRY_DSN=https://...@sentry.io/...
