ENV=development
DATABASE_URL=postgresql+asyncpg://medstats:medstats@localhost:5433/medstats
DATABASE_URL_SYNC=postgresql://medstats:medstats@localhost:5433/medstats
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-5

# File Storage (Cloudflare R2 or S3-compatible)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=medstats-files
S3_REGION=auto

SENTRY_DSN=

# Email (SMTP for beta, SES for production)
EMAIL_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=MedStats <hello@medstats.ai>
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
APP_BASE_URL=http://localhost:3000
