ENV=development
DATABASE_URL=postgresql+asyncpg://medstats:medstats@localhost:5433/medstats
DATABASE_URL_SYNC=postgresql://medstats:medstats@localhost:5433/medstats
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini

# File Storage (Cloudflare R2 or S3-compatible)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=medstats-files
S3_REGION=auto

SENTRY_DSN=
